<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Buttons Row -->
           <!-- <LinearLayout
                android:id="@+id/buttonLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

&lt;!&ndash;                <Button&ndash;&gt;
&lt;!&ndash;                    android:id="@+id/btnGoToRegister"&ndash;&gt;
&lt;!&ndash;                    android:layout_width="0dp"&ndash;&gt;
&lt;!&ndash;                    android:layout_height="wrap_content"&ndash;&gt;
&lt;!&ndash;                    android:layout_weight="1"&ndash;&gt;
&lt;!&ndash;                    android:text="Register"&ndash;&gt;
&lt;!&ndash;                    android:textSize="20sp" />&ndash;&gt;

              &lt;!&ndash;  <Button
                    android:id="@+id/btnGoToLogin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Login"
                    android:textSize="20sp" />&ndash;&gt;
            </LinearLayout>-->

            <!-- Budget and Logout Buttons --><LinearLayout
                android:id="@+id/budgetLayoutButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="117dp"
                android:layout_gravity="end">

              <!--<Button
                    android:id="@+id/BudgetActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Budget" />-->

                <Button
                    android:id="@+id/logoutButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Logout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp"
                    app:backgroundTint="@color/red"
                    android:layout_gravity="end"
                    app:cornerRadius="4dp"
                    app:rippleColor="@color/black"
                    />

            </LinearLayout>

            <!-- Balance Section -->
            <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="TOTAL BALANCE"
                android:textSize="14sp"
                tools:ignore="TextSizeCheck" />

            <TextView
                android:id="@+id/TotalBalanceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_gravity="center"
                android:text="R4000"
                android:textSize="18sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:id="@+id/balance_Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:orientation="horizontal">

                    <!-- Budget -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/Budget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$400"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Budget"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Expense -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/Expense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$400"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/red" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expense"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pie Chart -->
            <LinearLayout
                android:id="@+id/PirchartLinLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChart"
                    android:layout_width="match_parent"
                    android:layout_height="247dp"
                    android:layout_margin="16dp" />
            </LinearLayout>

            <!-- Title + Date Picker -->
            <LinearLayout
                android:id="@+id/dateAndTitleLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/recyclerview_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="Transactions"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="start" />

                <Button
                    android:id="@+id/datePickerButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="Select Date Range"
                    android:textAllCaps="false"
                    android:padding="12dp"
                    android:backgroundTint="@color/paleBlue"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mainrecyclerview"
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="Displays your transactions" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?android:attr/windowBackground"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:menu="@menu/bottom_nav_menu" />

    <!-- FAB above navigation bar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:contentDescription="Add transaction"
        app:backgroundTint="@color/greenBlue"
        app:tint="@android:color/black"
        android:src="@drawable/add_icon"
        app:fabSize="normal" />
</RelativeLayout>
